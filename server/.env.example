PORT=3001
NODE_ENV=development
SITE_URL=http://localhost:3001
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
# 必须以 shiju 开头；服务拒绝连接其他库
DB_NAME=shiju

# JWT 签名密钥（≥32 字符随机串）
JWT_SECRET=
BCRYPT_COST=12
IP_HASH_SALT=

SSR_ENABLED=1
SSR_CACHE_MAX=400
SSR_TIMEOUT_MS=1500
